# States to load for quick local runs. The server leaves this empty (= all states).
LOAD_STATES=MT
# Set to 0 to skip the data update that starts with the app (it fills in missing data and
# catches up on weekly and daily FCC files). The server timers keep working either way.
AUTO_UPDATE=1
# Email or web address shown on the results map for hams who want to be left off it.
# Leave it empty to hide that note.
MAP_CONTACT=
